[Unit]
Description=Spotify Connect speaker (librespot)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'mkdir -p /run/rg351v /storage/.cache/librespot'
ExecStart=/storage/.config/rg351v/bin/librespot \
  --name RG351V --device-type gameconsole \
  --backend alsa --device default \
  --cache /storage/.cache/librespot --disable-audio-cache \
  --bitrate 160 --initial-volume 35 \
  --onevent /storage/.config/rg351v/librespot-event.sh
ExecStopPost=/bin/rm -f /run/rg351v/playing
Restart=always
RestartSec=5
Nice=-5

[Install]
WantedBy=multi-user.target
